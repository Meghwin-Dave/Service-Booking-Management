 "html": "<style>\n    body {\n        font-family: 'Segoe UI', Arial, sans-serif;\n        color: #222;\n        background: #fff;\n        margin: 0;\n        padding: 0;\n    }\n    .sb-container {\n        max-width: 700px;\n        margin: 30px auto;\n        background: #f9f9f9;\n        border-radius: 12px;\n        box-shadow: 0 2px 12px rgba(0,0,0,0.07);\n        padding: 32px 40px;\n    }\n    .sb-header {\n        display: flex;\n        align-items: center;\n        border-bottom: 2px solid #e0e0e0;\n        padding-bottom: 18px;\n        margin-bottom: 28px;\n    }\n    .sb-logo {\n        width: 60px;\n        height: 60px;\n        margin-right: 18px;\n        border-radius: 8px;\n        object-fit: cover;\n        background: #eee;\n    }\n    .sb-title {\n        font-size: 2.1rem;\n        font-weight: 700;\n        color: #2d6cdf;\n        letter-spacing: 1px;\n    }\n    .sb-section {\n        margin-bottom: 28px;\n    }\n    .sb-label {\n        font-weight: 600;\n        color: #555;\n        margin-bottom: 4px;\n        display: block;\n    }\n    .sb-value {\n        font-size: 1.1rem;\n        color: #222;\n        margin-bottom: 10px;\n    }\n    .sb-row {\n        display: flex;\n        gap: 40px;\n        flex-wrap: wrap;\n    }\n    .sb-col {\n        flex: 1 1 220px;\n        margin-bottom: 18px;\n    }\n    .sb-footer {\n        border-top: 1px solid #e0e0e0;\n        margin-top: 32px;\n        padding-top: 18px;\n        text-align: right;\n        color: #888;\n        font-size: 0.95rem;\n    }\n</style>\n\n<div class=\"sb-container\">\n    <div class=\"sb-header\">\n        <!-- Replace src with your logo if needed -->\n        <img src=\"https://i.imgur.com/4M34hi2.png\" class=\"sb-logo\" alt=\"Logo\"/>\n        <div>\n            <div class=\"sb-title\">Service Booking Confirmation</div>\n            <div style=\"color:#888; font-size:1rem;\">Booking ID: <b>{{ doc.name }}</b></div>\n        </div>\n    </div>\n\n    <div class=\"sb-section sb-row\">\n        <div class=\"sb-col\">\n            <span class=\"sb-label\">Customer Name</span>\n            <div class=\"sb-value\">{{ doc.customer_name or doc.customer }}</div>\n        </div>\n        <div class=\"sb-col\">\n            <span class=\"sb-label\">Service Type</span>\n            <div class=\"sb-value\">{{ doc.service_type }}</div>\n        </div>\n        {% if doc.service_type == \"Others\" and doc.specify_other_service %}\n        <div class=\"sb-col\">\n            <span class=\"sb-label\">Other Service</span>\n            <div class=\"sb-value\">{{ doc.specify_other_service }}</div>\n        </div>\n        {% endif %}\n    </div>\n\n    <div class=\"sb-section sb-row\">\n        <div class=\"sb-col\">\n            <span class=\"sb-label\">Preferred Date & Time</span>\n            <div class=\"sb-value\">\n                {{ frappe.utils.format_datetime(doc.preferred_datetime) if doc.preferred_datetime else \"-\" }}\n            </div>\n        </div>\n        <div class=\"sb-col\">\n            <span class=\"sb-label\">Status</span>\n            <div class=\"sb-value\">\n                {{ doc.workflow_state or doc.status or \"Pending\" }}\n            </div>\n        </div>\n    </div>\n\n    <div class=\"sb-section\">\n        <span class=\"sb-label\">Created On</span>\n        <div class=\"sb-value\">\n            {{ frappe.utils.format_datetime(doc.creation) }}\n        </div>\n    </div>\n\n    <div class=\"sb-footer\">\n        Thank you for booking with us!<br>\n        <span style=\"color:#2d6cdf;\">Service Booking Team</span>\n    </div>\n</div>",
